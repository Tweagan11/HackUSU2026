{
  "name": "code-sergeant",
  "displayName": "Code Sergeant",
  "description": "Code Sergeant will make sure that your code works. And he'll make sure you know how to fix it. Don't you worry about that",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-sergeant.drill",
        "title": "Code Sergeant"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p . --outDir out && webpack --config webpack.config.js",
    "watch": "tsc -p . -w --outDir out",
    "package": "npm run compile",
    "compile-tests": "npm run compile",
    "watch-tests": "npm run watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
